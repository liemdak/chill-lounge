{
  "name": "chill-lounge",
  "productName": "Chill Lounge",
  "version": "0.3.0",
  "private": true,
  "description": "Video/image wallpaper + chill music player for Windows",
  "author": "liemdak",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "motion": "^14.0.0",
    "music-metadata": "^11.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.liemdak.chill-lounge",
    "productName": "Chill Lounge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chill Lounge",
      "artifactName": "ChillLounge-Setup-${version}.${ext}"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "vi"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "liemdak",
        "repo": "chill-lounge",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "koffi@3.3.2": true,
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liemdak/chill-lounge.git"
  }
}
